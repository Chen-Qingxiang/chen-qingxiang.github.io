{"id":"dumu","name":"杜牧一生行迹","shortName":"杜","period":"803–852","lifeStart":803,"lifeEnd":852.95,"subtitle":"从长安、洛阳科举，到洪州、宣州、扬州幕府；中后期长安—洛阳与黄州、池州、睦州、湖州外任交替。","note":"杜牧任官地点较清楚，月份常不详，因此大部分旅行窗口为年份/季节级估计；不把幕府驻地间的每次短差遣都画入主线。","bibliography":[{"title":"中国哲学书电子化计划：杜牧","url":"https://ctext.org/datawiki.pl?if=gb&res=791299"},{"title":"全唐五代词·杜牧小传","url":"https://ctext.org/wiki.pl?chapter=536259&if=gb"},{"title":"搜韵唐诗选·杜牧","url":"https://www.sou-yun.cn/PoemBookNav.aspx?b=&d=6"}],"events":[{"year":803,"time":803.5,"title":"生于长安","place":"陕西西安（唐：长安）","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"杜牧生于京兆万年杜氏家族。","source":"杜牧传记。"},{"year":828,"time":828.25,"title":"洛阳进士及第","place":"河南洛阳","mapLabel":"洛阳","lat":34.62,"lng":112.45,"summary":"大和二年在洛阳进士及第。","source":"中国哲学书电子化计划杜牧传。","travelStart":828.05,"travelEnd":828.25,"routeFromPrevious":[[34.5,110.2]],"travelPrecision":"季节级"},{"year":828,"time":828.42,"title":"赴长安制举","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"同年五月又通过制举，授弘文馆校书郎等职。","source":"杜牧传。","travelStart":828.3,"travelEnd":828.42,"routeFromPrevious":[[34.5,110.2]],"travelPrecision":"月份级"},{"year":828,"time":828.78,"title":"入洪州幕府","place":"江西南昌（唐：洪州）","mapLabel":"洪州","lat":28.68,"lng":115.86,"summary":"随江西观察使沈传师赴洪州幕府。","source":"杜牧传：828年秋入江西观察使幕。","travelStart":828.6,"travelEnd":828.78,"routeFromPrevious":[[32.1,112.1],[29.7,115.99]],"travelPrecision":"季节级"},{"year":829,"time":829.55,"title":"转宣州幕府","place":"安徽宣城（唐：宣州）","mapLabel":"宣州","lat":30.94,"lng":118.76,"summary":"沈传师调任宣歙观察使，杜牧随往宣州。","source":"杜牧传。","travelStart":829.4,"travelEnd":829.55,"routeFromPrevious":[[29.7,115.99]],"travelPrecision":"年份级"},{"year":833,"time":833.42,"title":"入扬州牛僧孺幕","place":"江苏扬州","mapLabel":"扬州","lat":32.39,"lng":119.42,"summary":"转入淮南节度使牛僧孺幕府，扬州时期成为其生平最著名的地方经历之一。","source":"杜牧传：833年留扬州，任推官、掌书记。","travelStart":833.25,"travelEnd":833.42,"routeFromPrevious":[[31.8,118.0]],"travelPrecision":"月份级"},{"year":835,"time":835.25,"title":"入长安任监察御史","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"入朝任监察御史。","source":"杜牧传。","travelStart":835.08,"travelEnd":835.25,"routeFromPrevious":[[34.2,117.3],[34.62,112.45]],"travelPrecision":"季节级"},{"year":835,"time":835.6,"title":"分司东都洛阳","place":"河南洛阳","mapLabel":"洛阳","lat":34.62,"lng":112.45,"summary":"请求外调洛阳，因而避开同年甘露之变的核心清洗。","source":"杜牧传。","travelStart":835.45,"travelEnd":835.6,"routeFromPrevious":[[34.5,110.2]],"travelPrecision":"月份级"},{"year":837,"time":837.2,"title":"赴扬州照料弟弟","place":"江苏扬州","mapLabel":"扬州","lat":32.39,"lng":119.42,"summary":"为照料眼疾严重的弟弟杜顗，一度离职赴扬州。","source":"杜牧传：837年返扬州照料弟弟。","travelStart":837.0,"travelEnd":837.2,"routeFromPrevious":[[34.2,117.3]],"travelPrecision":"年份级"},{"year":837,"time":837.62,"title":"再入宣州幕","place":"安徽宣城","mapLabel":"宣州","lat":30.94,"lng":118.76,"summary":"携弟转入崔郸等宣州幕府。","source":"杜牧传：后复为宣州幕吏。","travelStart":837.45,"travelEnd":837.62,"routeFromPrevious":[[31.8,118.0]],"travelPrecision":"年份级"},{"year":838,"time":838.45,"title":"召回长安","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"任左补阙、史馆修撰，重新进入中央。","source":"杜牧传。","travelStart":838.2,"travelEnd":838.45,"routeFromPrevious":[[32.1,118.7],[34.62,112.45]],"travelPrecision":"年份级"},{"year":842,"time":842.35,"title":"出守黄州","place":"湖北黄冈（唐：黄州）","mapLabel":"黄州","lat":30.45,"lng":114.88,"summary":"会昌二年外放黄州刺史，开始连续数州刺史阶段。","source":"杜牧小传。","travelStart":842.15,"travelEnd":842.35,"routeFromPrevious":[[33.6,114.7],[31.6,114.9]],"travelPrecision":"年份级"},{"year":844,"time":844.35,"title":"转池州刺史","place":"安徽池州","mapLabel":"池州","lat":30.66,"lng":117.49,"summary":"会昌四年转池州刺史。","source":"杜牧小传。","travelStart":844.15,"travelEnd":844.35,"routeFromPrevious":[[30.5,116.0]],"travelPrecision":"年份级"},{"year":846,"time":846.35,"title":"徙睦州刺史","place":"浙江建德（唐：睦州）","mapLabel":"睦州","lat":29.47,"lng":119.28,"summary":"会昌六年转睦州刺史。","source":"杜牧小传。","travelStart":846.15,"travelEnd":846.35,"routeFromPrevious":[[29.9,118.1]],"travelPrecision":"年份级"},{"year":848,"time":848.35,"title":"返长安任司勋员外郎","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"大中二年返朝，任司勋员外郎、史馆修撰。","source":"杜牧传。","travelStart":848.05,"travelEnd":848.35,"routeFromPrevious":[[30.3,120.2],[32.2,119.4],[34.62,112.45]],"travelPrecision":"年份级"},{"year":850,"time":850.35,"title":"自请知湖州","place":"浙江湖州","mapLabel":"湖州","lat":30.89,"lng":120.09,"summary":"主动请求出任湖州刺史。","source":"杜牧传：850年任湖州刺史。","travelStart":850.1,"travelEnd":850.35,"routeFromPrevious":[[32.2,119.4]],"travelPrecision":"年份级"},{"year":851,"time":851.45,"title":"再召长安","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"大中五年返朝，任考功郎中、知制诰等。","source":"杜牧传。","travelStart":851.2,"travelEnd":851.45,"routeFromPrevious":[[32.2,119.4],[34.62,112.45]],"travelPrecision":"年份级"},{"year":852,"time":852.95,"title":"卒于长安","place":"陕西西安","mapLabel":"长安","lat":34.27,"lng":108.95,"summary":"大中六年冬病卒。","source":"杜牧传，卒年一般作852。","routeFromPrevious":[]}]}